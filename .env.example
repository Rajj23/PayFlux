# Copy this file to .env for local Docker Compose use.
# On the server, deploy.sh generates a separate ignored server.env file.
POSTGRES_DB=payflux
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-database-password
DB_URL=jdbc:postgresql://postgres:5432/payflux

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

USER_SERVICE_URL=http://user-service:8081
TRANSACTION_SERVICE_URL=http://transaction-service:8082
WALLET_SERVICE_URL=http://wallet-service:8083/api/v1/wallets
WALLET_GATEWAY_URL=http://wallet-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084
REWARD_SERVICE_URL=http://reward-service:8089

# Public browser origin (CORS) and the Docker-internal Next.js rewrite target.
FRONTEND_URL=http://127.0.0.1:3000
API_INTERNAL_URL=http://api-gateway:8080

# Used only when exposing the demo ports directly (without the server proxy).
GATEWAY_PORT=8080
FRONTEND_PORT=3000